# Arquivo de EXEMPLO (sem segredos). Faça uma cópia para .env e preencha lá.
# Nunca faça commit do .env nem insira chaves reais neste exemplo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LOG_LEVEL=INFO
# KNOWLEDGE_DIR=./data/knowledge
# Banco SQLite por padrão: %LOCALAPPDATA%\ArecoMultiagentes\knowledge.sqlite (Windows).
# Não configure DATABASE_PATH no Google Drive/OneDrive.
# DATABASE_PATH=C:\caminho-local\knowledge.sqlite
# AGENT_ENGINE=sdk não é mais necessário: o SDK é o único motor.
